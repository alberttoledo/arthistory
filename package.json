  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@remotion/bundler": "^4.0.540",
    "@remotion/cli": "^4.0.540",
    "@remotion/google-fonts": "^4.0.540",
    "@remotion/renderer": "^4.0.540",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.540",
    "zod": "^4.6.7"
  }
