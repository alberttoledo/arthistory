{
  "name": "content-factory",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "cf": "tsx packages/cli/src/cf.ts",
    "preview": "remotion studio packages/video/src/index.ts",
